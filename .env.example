# DB
DATABASE_URL=

# Auth
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your-publishable-key
CLERK_SECRET_KEY=your-secret-key
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/signup

# Payments
STRIPE_SECRET_KEY=your-secret-key
STRIPE_WEBHOOK_SECRET=your-webhook-secret
NEXT_PUBLIC_STRIPE_PORTAL_LINK=
NEXT_PUBLIC_STRIPE_PAYMENT_LINK_YEARLY=
NEXT_PUBLIC_STRIPE_PAYMENT_LINK_MONTHLY=

# Analytics
NEXT_PUBLIC_POSTHOG_KEY=your-key
NEXT_PUBLIC_POSTHOG_HOST=your-host

# Duffel API
DUFFEL_ACCESS_TOKEN=

# Google Maps
GOOGLE_MAPS_API_KEY=your-api-key

# Google Gemini
GEMINI_API_KEY=your_gemini_api_key_here

# Shared secret for Vercel Cron invocations. Cron routes fail closed (503) without it.
CRON_SECRET=

# Feature flags (unset/false = off).
# Keep flight booking OFF until customer payment is collected — otherwise Duffel
# orders are paid from the platform's own Duffel balance. See SPEC.md Phase D8.
FLIGHTS_BOOKING_ENABLED=
AI_PLANNER_PRO_GATE=

# Flight service fee (the platform's margin on a Duffel booking).
# IMPORTANT: at 0% you LOSE money on every booking — the customer is charged the offer
# total, Duffel is paid that same total from your balance, and Stripe still takes its
# processing fee (~1.5-2.9% + fixed) plus FX. Set a percentage before enabling booking.
FLIGHT_SERVICE_FEE_PERCENT=
# Flat floor in major units. Currency-blind: a value tuned for GBP is meaningless
# against JPY. Prefer the percentage unless you charge in a single currency.
FLIGHT_SERVICE_FEE_MINIMUM=
